# --- Модель ---------------------------------------------------------------
# Gemini: ключ бесплатно в Google AI Studio (aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=

# Альтернатива — GigaChat, работает из РФ без VPN.
# Формат вызовов совместим, менять код не нужно:
# LLM_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# LLM_MODEL=GigaChat-2

# --- Хранилище -------------------------------------------------------------
# По умолчанию проект сам определяет режим: если Google не настроен,
# реестр читается и пишется в локальный файл demo_workspace.xlsx.
# Принудительно: DEMO_MODE=1 (локально) или DEMO_MODE=0 (только Google).
# DEMO_MODE=

# --- Google (необязательно, для работы с настоящей таблицей) ----------------
GOOGLE_CREDENTIALS=credentials.json
SHEET_ID=
CALENDAR_ID=
TIMEZONE=Europe/Moscow

# --- Telegram (для bot.py) ------------------------------------------------
# Токен у @BotFather, свой числовой id — у @userinfobot.
# Без ALLOWED_USER_ID бот отвечает всем, кто его найдёт.
TELEGRAM_TOKEN=
ALLOWED_USER_ID=
